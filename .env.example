# Copy to .env and `chmod 600 .env`. Never commit .env (it's gitignored).

# --- Broker: Alpaca (free paper account: https://app.alpaca.markets/signup)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Live trading lock. Paper trading is the default. To trade REAL money you need
# mode = "live" in jarvis.toml AND this exact value. Leave it unset until you've run on paper.
# JARVIS_LIVE_TRADING=I_UNDERSTAND_THE_RISKS

# --- Analyst (optional). Pick one in jarvis.toml: rules | claude | claude-code | ollama
# claude      -> needs an Anthropic API key + `pip install "jarvis-trading-agent[ai]"`
# claude-code -> uses your Claude subscription through the `claude` CLI, no key needed
# ollama      -> free + private, runs a local model
ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Phone alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Dashboard (optional): fixed access key instead of the auto-generated one
# JARVIS_DASHBOARD_TOKEN=
