# Copy to .env and `chmod 600 .env`. Never commit .env (it's gitignored).

# --- Broker: Alpaca (free paper account: https://app.alpaca.markets/signup)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Live trading lock. Paper trading is the default. To trade REAL money you need
# mode = "live" in jarvis.toml AND this exact value. Leave it unset until you've run on paper.
# JARVIS_LIVE_TRADING=I_UNDERSTAND_THE_RISKS

# --- Analyst (optional). Pick one in jarvis.toml: rules | claude | claude-code | ollama
# claude      -> needs an Anthropic API key + `pip install ".[ai]"`
# claude-code -> uses your Claude subscription through the `claude` CLI, no key needed
# ollama      -> free + private, runs a local model
ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Brain (optional): override jarvis.toml for one run
# JARVIS_BRAIN=codex
# JARVIS_PROJECT_ROOTS=~/work,~/projects

# --- Telegram: talk to JARVIS from anywhere (create a bot with @BotFather).
# TELEGRAM_CHAT_ID is an allow-list: comma-separated chat ids. Everyone else is ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Phone calls (optional, Twilio): JARVIS calls you, and you can call JARVIS.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000          # your Twilio number
# JARVIS_OWNER_PHONE=+15551112222   # the ONLY number JARVIS calls and answers
# JARVIS_PUBLIC_URL=https://your-mac.your-tailnet.ts.net   # HTTPS URL Twilio can reach (calls *to* JARVIS)

# --- Phone app over Tailscale: extra hostnames the HUD accepts
# JARVIS_ALLOWED_HOSTS=your-mac.your-tailnet.ts.net

# --- Dashboard (optional): fixed access key instead of the auto-generated one
# JARVIS_DASHBOARD_TOKEN=
